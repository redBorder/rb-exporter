#!/usr/bin/bash
set -euo pipefail

BINARY=/usr/sbin/pmacctd
BASE_DIR=/etc/rb-exporter
RUN_DIR=/run

CONFIGURED=0
RUNNING=0


rm -f ${RUN_DIR}/rb-exporter-*.pid 2>/dev/null || true

for dir in "${BASE_DIR}"/*; do
  [ ! -d "$dir" ] && continue

  iface=$(basename "$dir")
  [ "$iface" = "lo" ] && continue

  conf="${dir}/rb-exporter.conf"
  pidfile="${RUN_DIR}/rb-exporter-${iface}.pid"

  if [ ! -f "$conf" ]; then
    continue
  fi

  CONFIGURED=1

  "$BINARY" -i "$iface" -F "$pidfile" -f "$conf" >/dev/null 2>&1 || true
done

sleep 1


for pidfile in ${RUN_DIR}/rb-exporter-*.pid; do
  [ ! -f "$pidfile" ] && continue

  pid=$(cat "$pidfile" 2>/dev/null || true)
  [ -z "$pid" ] && continue

  if kill -0 "$pid" 2>/dev/null; then
    RUNNING=1
    break
  fi
done


if [ "$CONFIGURED" -eq 0 ]; then
  exit 0
fi

if [ "$RUNNING" -eq 1 ]; then
  exit 0
fi

exit 1